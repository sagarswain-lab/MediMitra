# Groq AI (LLM Provider — text tasks)
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini AI (Vision tasks — prescription reader & medicine scanner)
# Get a FREE key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Mem0 (Persistent AI Memory — optional; local mode used if absent)
MEM0_API_KEY=your_mem0_api_key_here

# Google OAuth (for Sign-In feature)
GOOGLE_CLIENT_ID=your_google_client_id_here

# JWT Secret (generate a strong random string)
JWT_SECRET=your_jwt_secret_here

# Database URL (PostgreSQL for production, omit for SQLite local dev)
# Format: postgresql://user:password@host:port/database
# Example: postgresql://medimitra_user:password123@dpg-abc123.oregon-postgres.render.com/medimitra_db
DATABASE_URL=